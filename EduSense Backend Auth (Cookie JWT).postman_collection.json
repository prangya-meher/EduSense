              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"oneplusonu@gmail.com\",\n  \"otp\": \"9191\"\n}"
            },
            "url": {
              "raw": "{{base_url_host}}/api/auth/verify-otp/",
