  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register (creates user + sends OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"suimit User\",\n  \"email\": \"oneplusonu@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url_host}}/api/auth/register/",
              "host": [
                "{{base_url_host}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Verify OTP (logs in + sets cookie)",
